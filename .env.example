# Server
PORT=3000
DEBUG=false
PUBLIC_BASE_URL=http://localhost:3000

# Upstream PDDikti data source (this API is a proxy in front of it).
UPSTREAM_BASE_URL=https://pddikti.kemdiktisaintek.go.id/api
# Cloudflare guards the upstream. Provide a `cf_clearance` cookie + the EXACT User-Agent it
# was issued to (from a browser session; wrong/missing UA → 403). The cookie expires.
UPSTREAM_HEADERS={"Cookie":"cf_clearance=<token>","User-Agent":"<exact UA the token was issued to>"}
UPSTREAM_TIMEOUT_MS=15000

# Inbound API-key auth (optional). Gates the /api/* REST surface only — empty
# API_KEY = public (auth disabled). The /mcp MCP endpoint is always public,
# regardless of this value, so browser connectors (claude.ai) can reach it.
# Clients send X-API-Key; the web SPA uses an httpOnly session cookie minted at /.
API_KEY=
SESSION_TTL_S=86400

# Operator config page at /config. Set CONFIG_PASSWORD to enable it (empty = disabled/404).
# There, an operator pastes fresh cf_clearance + User-Agent (and base URL / timeout); saved
# values persist to CONFIG_STORE_PATH and override UPSTREAM_* at runtime (no restart).
# The store file holds a live cf_clearance in plaintext — keep it gitignored / restricted.
CONFIG_PASSWORD=
CONFIG_STORE_PATH=./runtime-config.json

# Service metadata
API_AVAILABILITY=true
API_VERSION=1.0.0
LAST_UPDATE=2026-06-19T00:00:00+07:00

# Branding / attribution (kept generic and configurable)
CREDIT_LINE=Data © PDDikti
SUPPORT_EMAIL=
SUPPORT_URL=

# Redis cache (optional). When CACHE_ENABLED=false the cache is a no-op passthrough.
# Redis failures degrade gracefully — requests still reach the upstream.
CACHE_ENABLED=false
CACHE_TTL_S=600
# REDIS_URL wins verbatim if set (e.g. redis://user:pass@host:6379/0); otherwise the
# discrete fields below are assembled into a URL.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
