{
  "name": "pddikti-api",
  "version": "0.6.0",
  "license": "AGPL-3.0-or-later",
  "description": "Bun + Hono API for structured access to Indonesia higher-education data (PDDikti).",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "mcp": "bun run src/mcp/stdio.ts",
    "mcp:dev": "bun run --hot src/mcp/stdio.ts",
    "mcp:inspect": "bunx @modelcontextprotocol/inspector bun run src/mcp/stdio.ts",
    "openapi:export": "bun run scripts/export-openapi.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bun-plugin-tailwind": "^0.1.2",
    "hono": "^4.12.26",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.6.0"
  }
}
