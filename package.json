{
  "name": "pddikti-api",
  "version": "1.1.0",
  "private": true,
  "description": "Unofficial PDDikti API and MCP server for Indonesian higher-education data: universities, study programs, lecturers, and students.",
  "keywords": [
    "pddikti",
    "pddikti-api",
    "api-pddikti",
    "pddikti-mcp",
    "mcp-pddikti",
    "forlap-dikti",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "indonesia",
    "higher-education",
    "perguruan-tinggi",
    "universitas",
    "kampus",
    "program-studi",
    "dosen",
    "mahasiswa",
    "openapi",
    "rest-api",
    "bun",
    "hono"
  ],
  "homepage": "https://github.com/andikadevs/pddikti#readme",
  "bugs": {
    "url": "https://github.com/andikadevs/pddikti/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andikadevs/pddikti.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Andika Dwi Saputra <hello@andikadevs.space> (https://andikadevs.space)",
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "DEBUG=true bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "mcp": "bun run src/mcp/stdio.ts",
    "mcp:dev": "bun run --hot src/mcp/stdio.ts",
    "mcp:inspect": "bunx @modelcontextprotocol/inspector bun run src/mcp/stdio.ts",
    "openapi:export": "bun run scripts/export-openapi.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hono/swagger-ui": "0.6.2",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.14",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
