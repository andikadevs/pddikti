{
  "name": "pddikti-api",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only proxy API and MCP server for Indonesian higher-education data (PDDikti).",
  "keywords": [
    "pddikti",
    "indonesia",
    "higher-education",
    "api",
    "mcp",
    "bun",
    "hono"
  ],
  "homepage": "https://github.com/andikadevs/pddikti#readme",
  "bugs": {
    "url": "https://github.com/andikadevs/pddikti/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andikadevs/pddikti.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Andika Dwi Saputra <hello@andikadevs.space> (https://andikadevs.space)",
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "mcp": "bun run src/mcp/stdio.ts",
    "mcp:dev": "bun run --hot src/mcp/stdio.ts",
    "mcp:inspect": "bunx @modelcontextprotocol/inspector bun run src/mcp/stdio.ts",
    "openapi:export": "bun run scripts/export-openapi.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "0.18.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "bun-plugin-tailwind": "0.1.2",
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
